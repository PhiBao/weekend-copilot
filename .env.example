# Weekend Copilot — environment template.
# Copy to `.env.local` (local dev) or set as Vercel project env vars (production).
# `.env*` is gitignored: real keys must NEVER be committed. This file holds placeholders only.

# --- Qwen narration (Bitget hackathon proxy) ---
# Powers the "AI transmission" card. Optional: without these, the app serves the
# labelled deterministic template instead. Model default is qwen3.8-max.
LLM_BASE_URL=https://hackathon.bitgetops.com/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-max

# --- TypeSafe intent dispatch (Jev) ---
# Powers confidence-aware parsing of the plain-English command box.
# Get a key at https://console.typesafe.ai/keys
# Optional: without it, the deterministic regex parser handles all input.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
